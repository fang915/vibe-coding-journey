# 寻味 / Xunwei —— 环境变量模板（Day 23）
#
# 怎么用：
#   1. 复制一份，改名成 .env        （cp .env.example .env）
#   2. 把下面的占位值换成真值
#   3. .env 已被 .gitignore 挡住，永远不会被提交
#
# ★ 这个文件本身**只放变量名和说明，不放任何真值**，所以它可以安全地进仓库 ——
#   它的作用是告诉下一个人「这个项目需要配哪几个变量」，而不是替他保管密码。
#
# ★ 当前这个项目的真实变量配在**腾讯云 CloudBase 控制台**的云函数配置里
#   （云函数 scf-nodejs-helloworld-yfxb → 配置 → 环境变量），不是本地 .env。
#   本地 .env 只在你想跑本地实验时用。
#
# 变量名与代码里的对应关系：
#   cloudfunctions/api/db.js    → CLOUDBASE_ENV_ID、CLOUDBASE_API_KEY
#   cloudfunctions/api/index.js → ADMIN_TOKEN


# ── 云开发环境 ID ──────────────────────────────────────────────
# db.js 里已内置本项目环境的默认值，一般不用改。
# 换环境（比如自建测试环境）时才需要显式指定。
CLOUDBASE_ENV_ID=your-cloudbase-env-id


# ── 数据库访问密钥 ────────────────────────────────────────────
# 云开发控制台 → 环境 → 访问管理 → API Key 里生成。
# 不配的话，所有读/写接口都会以「网关 401」的样子失败，
# 而云函数会明确回一句「没读到环境变量 CLOUDBASE_API_KEY」指明原因。
CLOUDBASE_API_KEY=your-cloudbase-api-key


# ── 策展端管理口令 ────────────────────────────────────────────
# 保护写接口 POST / PATCH / DELETE 用的，请求头 X-Admin-Token 要带这个值。
# 自己随便设一串够长的随机字符即可（例：openssl rand -hex 24）。
# 不配的话，写接口一律回 500 并点名这个变量；配了但请求头没带 → 401。
ADMIN_TOKEN=your-admin-token
