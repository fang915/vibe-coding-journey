# 环境变量文件（存数据库连接串、密钥等敏感信息，永不提交）
.env
.env.local
.env.*.local

# 环境变量模板例外：.env.example 里只有变量名和说明、没有任何真值，
# 它是"该配哪几个变量"的说明书，要跟着仓库走。
!.env.example

# 证书与私钥（本地调试可能用到，绝不提交）
*.pem
*.key

# 依赖文件夹（npm 安装会生成，文件极多，不需要提交）
node_modules/

# 静态托管部署包（index.html / css / js / data 的副本，用于上传到 CloudBase
# 静态网站托管；它不是源码，是构建产物性质，进仓库只会造成重复，故忽略）
deploy/

# 管理口令本地文件（Day 18 调 POST 接口用，内容是 X-Admin-Token，绝不提交）
tests/admin-token.txt

# 历史版本快照（Day 26 新增）。回退演练要"把上一版原样传回去"，
# 所以每个发布版本都从 deploy/ 存一份到这里，作为可上传的回退产物。
# 与 deploy/ 同理：它是产物不是源码，而且任何一个版本都能用
# `git archive <tag>` 重新生成，进仓库只会造成重复，故忽略。
releases/
